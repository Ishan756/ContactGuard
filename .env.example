# ==============================================================================
# ContractGuard Environment Configuration (.env.example)
# Copy this file to .env and customize values for local development.
# ==============================================================================

# Application Configuration
APP_NAME=ContractGuard
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Security & CORS (Comma-separated origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contractguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/contractguard

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=contract_clauses
QDRANT_POLICY_COLLECTION=company_policies

# AI / LLM Provider & Embedding Engine
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-1.5-pro
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Clause Extraction LLM Provider
# Use "mock" for tests/offline development; use "gemini" with a real GEMINI_API_KEY for production.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
CLAUSE_CHUNK_SIZE=6000
CLAUSE_CHUNK_OVERLAP=600
CLAUSE_MIN_CONFIDENCE=0.5

# Policy Knowledge Base Chunking & Retrieval Limits
POLICY_CHUNK_SIZE=500
POLICY_CHUNK_OVERLAP=100
POLICY_RETRIEVAL_LIMIT=5
POLICY_RETRIEVAL_MIN_SIMILARITY=0.0
POLICY_RETRIEVAL_STATUSES=["active"]

# Risk Analysis Agent
# Severity is configured here (or derived from policy rules), never from LLM confidence.
RISK_ANALYSIS_ENABLE_MODEL=true
RISK_SEVERITY_LIABILITY_UNLIMITED=critical
RISK_SEVERITY_LIABILITY_CAP=high
RISK_SEVERITY_TERMINATION_NOTICE=high
RISK_SEVERITY_PAYMENT_PERIOD=medium
RISK_SEVERITY_POLICY_DEVIATION=medium
RISK_SEVERITY_MISSING_DATA_PROTECTION=high
RISK_SEVERITY_MISSING_CLAUSE=high
RISK_SEVERITY_MISSING_EVIDENCE=informational
RISK_SEVERITY_POSSIBLE_LEGAL_CONCERN=informational
RISK_REQUIRED_CLAUSE_CATEGORIES=[]

# Evidence Validation / Critic Agent
# Bounded correction retries; exhausted findings remain unverified, never auto-approved.
VALIDATION_ENABLE=true
VALIDATION_MAX_RETRIES=2
VALIDATION_EXPLANATION_MIN_OVERLAP=2
VALIDATION_DUPLICATE_DETECTION=true

# Document Processing & Storage
STORAGE_BACKEND=local
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "docx"]

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
# Optional local reviewer defaults for the Vite dev server. If omitted in development,
# the UI falls back to local-reviewer / dev-workflow-review-key. Production builds should
# collect reviewer credentials through the Settings page or a deployment identity provider.
VITE_REVIEWER_ID=local-reviewer
VITE_WORKFLOW_API_KEY=dev-workflow-review-key

# LangGraph Workflow Orchestration & Human Review
# Change this key outside local development. Required in X-Workflow-Key for workflow APIs.
WORKFLOW_REVIEW_API_KEY=dev-workflow-review-key
WORKFLOW_MAX_RETRIES=2
WORKFLOW_MAX_STEPS=30
WORKFLOW_MAX_REVISIONS=2
# auto|postgres|sqlite|memory. Production should use postgres.
WORKFLOW_CHECKPOINT_BACKEND=auto
# Optional explicit PostgreSQL checkpoint connection string (plain postgresql://, not +asyncpg).
WORKFLOW_CHECKPOINT_DATABASE_URL=
WORKFLOW_CHECKPOINT_SQLITE_PATH=data/langgraph_checkpoints.db

# Evaluation Benchmark
# Optional override for the latest report consumed by GET /api/v1/evaluation/summary.
# Defaults to <repository>/evaluation/reports/latest.json.
EVALUATION_REPORT_PATH=
